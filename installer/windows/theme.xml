<?xml version="1.0" encoding="utf-8"?>
<!--
  Convx's setup window, for WiX's standard bootstrapper application (WixStdBA, WiX 5).
  The pictures come from make_art.py. Colours here are BGR: "482dfa" is Convx red, #FA2D48.
  Everything the setup draws sits on the pure black left of the background, and every label has
  a black background, so text never needs the window behind it.
-->
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil" ImageFile="background.png">
    <Font Id="0" Height="-13" Weight="400" Foreground="ffffff" Background="000000">Segoe UI</Font>
    <Font Id="1" Height="-26" Weight="600" Foreground="ffffff" Background="000000">Segoe UI</Font>
    <Font Id="2" Height="-14" Weight="400" Foreground="aaa1a1" Background="000000">Segoe UI</Font>
    <Font Id="3" Height="-12" Weight="400" Foreground="938e8e" Background="000000">Segoe UI</Font>
    <Font Id="4" Height="-15" Weight="600" Foreground="ffffff">Segoe UI</Font>

    <Image Id="Mark" ImageFile="mark.png">
        <AlternateResolution ImageFile="mark@2x.png" />
        <AlternateResolution ImageFile="mark@3x.png" />
    </Image>
    <Image Id="Wordmark" ImageFile="wordmark.png">
        <AlternateResolution ImageFile="wordmark@2x.png" />
        <AlternateResolution ImageFile="wordmark@3x.png" />
    </Image>
    <Image Id="Primary" ImageFile="primary.png">
        <AlternateResolution ImageFile="primary@2x.png" />
        <AlternateResolution ImageFile="primary@3x.png" />
    </Image>
    <Image Id="PrimaryHover" ImageFile="primary-hover.png">
        <AlternateResolution ImageFile="primary-hover@2x.png" />
        <AlternateResolution ImageFile="primary-hover@3x.png" />
    </Image>
    <Image Id="PrimaryPressed" ImageFile="primary-pressed.png">
        <AlternateResolution ImageFile="primary-pressed@2x.png" />
        <AlternateResolution ImageFile="primary-pressed@3x.png" />
    </Image>
    <Image Id="Secondary" ImageFile="secondary.png">
        <AlternateResolution ImageFile="secondary@2x.png" />
        <AlternateResolution ImageFile="secondary@3x.png" />
    </Image>
    <Image Id="SecondaryHover" ImageFile="secondary-hover.png">
        <AlternateResolution ImageFile="secondary-hover@2x.png" />
        <AlternateResolution ImageFile="secondary-hover@3x.png" />
    </Image>
    <Image Id="SecondaryPressed" ImageFile="secondary-pressed.png">
        <AlternateResolution ImageFile="secondary-pressed@2x.png" />
        <AlternateResolution ImageFile="secondary-pressed@3x.png" />
    </Image>
    <Image Id="Close" ImageFile="close.png">
        <AlternateResolution ImageFile="close@2x.png" />
        <AlternateResolution ImageFile="close@3x.png" />
    </Image>
    <Image Id="CloseHover" ImageFile="close-hover.png">
        <AlternateResolution ImageFile="close-hover@2x.png" />
        <AlternateResolution ImageFile="close-hover@3x.png" />
    </Image>
    <Image Id="ClosePressed" ImageFile="close-pressed.png">
        <AlternateResolution ImageFile="close-pressed@2x.png" />
        <AlternateResolution ImageFile="close-pressed@3x.png" />
    </Image>
    <Image Id="Progress" ImageFile="progress.png">
        <AlternateResolution ImageFile="progress@2x.png" />
        <AlternateResolution ImageFile="progress@3x.png" />
    </Image>

    <Window Width="560" Height="360" HexStyle="900a0000" FontId="0" Caption="#(loc.Caption)" SourceX="0" SourceY="0">
        <ImageControl X="40" Y="40" Width="52" Height="52" ImageId="Mark" />
        <ImageControl X="104" Y="41" Width="132" Height="34" ImageId="Wordmark" />
        <Label X="106" Y="76" Width="200" Height="18" FontId="3" DisablePrefix="yes">#(loc.Version)</Label>
        <Button X="-16" Y="16" Width="28" Height="28">
            <ButtonImage ImageId="Close" />
            <ButtonHoverImage ImageId="CloseHover" />
            <ButtonSelectedImage ImageId="ClosePressed" />
            <CloseWindowAction />
        </Button>

        <Page Name="Loading" />
        <Page Name="Help">
            <Label X="40" Y="136" Width="300" Height="36" FontId="1" DisablePrefix="yes">#(loc.HelpHeader)</Label>
            <Label X="40" Y="180" Width="300" Height="90" FontId="3" DisablePrefix="yes">#(loc.HelpText)</Label>
            <Button X="40" Y="-40" Width="120" Height="44" TabStop="yes" FontId="4">
                <Text>#(loc.CloseButton)</Text>
                <ButtonImage ImageId="Secondary" />
                <ButtonHoverImage ImageId="SecondaryHover" />
                <ButtonSelectedImage ImageId="SecondaryPressed" />
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Install">
            <Label X="40" Y="136" Width="300" Height="36" FontId="1" DisablePrefix="yes">
                <Text>#(loc.InstallHeader)</Text>
                <Text Condition="ConvxInstalledVersion &gt; v0.0.0.0">#(loc.UpdateHeader)</Text>
            </Label>
            <Label X="40" Y="180" Width="300" Height="60" FontId="2" DisablePrefix="yes">
                <Text>#(loc.InstallMessage)</Text>
                <Text Condition="ConvxInstalledVersion &gt; v0.0.0.0">#(loc.UpdateMessage)</Text>
            </Label>
            <Button Name="InstallButton" X="40" Y="-40" Width="156" Height="44" TabStop="yes" FontId="4">
                <Text>#(loc.InstallButton)</Text>
                <Text Condition="ConvxInstalledVersion &gt; v0.0.0.0">#(loc.UpdateButton)</Text>
                <ButtonImage ImageId="Primary" />
                <ButtonHoverImage ImageId="PrimaryHover" />
                <ButtonSelectedImage ImageId="PrimaryPressed" />
            </Button>
        </Page>
        <Page Name="Modify">
            <Label X="40" Y="136" Width="300" Height="36" FontId="1" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
            <Label X="40" Y="180" Width="300" Height="60" FontId="2" DisablePrefix="yes">#(loc.ModifyMessage)</Label>
            <Button Name="UninstallButton" X="40" Y="-40" Width="156" Height="44" TabStop="yes" FontId="4">
                <Text>#(loc.UninstallButton)</Text>
                <ButtonImage ImageId="Primary" />
                <ButtonHoverImage ImageId="PrimaryHover" />
                <ButtonSelectedImage ImageId="PrimaryPressed" />
            </Button>
            <Button X="208" Y="-40" Width="120" Height="44" TabStop="yes" FontId="4">
                <Text>#(loc.CloseButton)</Text>
                <ButtonImage ImageId="Secondary" />
                <ButtonHoverImage ImageId="SecondaryHover" />
                <ButtonSelectedImage ImageId="SecondaryPressed" />
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Progress">
            <Label X="40" Y="136" Width="300" Height="36" FontId="1" DisablePrefix="yes">
                <Text>#(loc.ProgressHeader)</Text>
                <Text Condition="WixBundleAction = 3 OR WixBundleAction = 4">#(loc.ProgressUninstallHeader)</Text>
                <Text Condition="ConvxInstalledVersion &gt; v0.0.0.0">#(loc.ProgressUpdateHeader)</Text>
            </Label>
            <Label X="40" Y="180" Width="300" Height="24" FontId="2" DisablePrefix="yes">#(loc.ProgressMessage)</Label>
            <Progressbar Name="OverallCalculatedProgressbar" X="40" Y="232" Width="300" Height="6">
                <ProgressbarImage ImageId="Progress" />
            </Progressbar>
            <Button Name="ProgressCancelButton" X="40" Y="-40" Width="120" Height="44" TabStop="yes" FontId="4">
                <Text>#(loc.CancelButton)</Text>
                <ButtonImage ImageId="Secondary" />
                <ButtonHoverImage ImageId="SecondaryHover" />
                <ButtonSelectedImage ImageId="SecondaryPressed" />
            </Button>
        </Page>
        <Page Name="ProgressPassive">
            <Label X="40" Y="136" Width="300" Height="36" FontId="1" DisablePrefix="yes">
                <Text>#(loc.ProgressHeader)</Text>
                <Text Condition="WixBundleAction = 3 OR WixBundleAction = 4">#(loc.ProgressUninstallHeader)</Text>
                <Text Condition="ConvxInstalledVersion &gt; v0.0.0.0">#(loc.ProgressUpdateHeader)</Text>
            </Label>
            <Label X="40" Y="180" Width="300" Height="24" FontId="2" DisablePrefix="yes">#(loc.ProgressMessage)</Label>
            <Progressbar Name="OverallCalculatedProgressbar" X="40" Y="232" Width="300" Height="6">
                <ProgressbarImage ImageId="Progress" />
            </Progressbar>
        </Page>
        <Page Name="Success">
            <Label X="40" Y="136" Width="300" Height="36" FontId="1" DisablePrefix="yes">
                <Text>#(loc.SuccessHeader)</Text>
                <Text Condition="WixBundleAction = 3 OR WixBundleAction = 4">#(loc.SuccessUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.SuccessInstallHeader)</Text>
            </Label>
            <Label X="40" Y="180" Width="300" Height="60" FontId="2" DisablePrefix="yes">
                <Text>#(loc.SuccessMessage)</Text>
                <Text Condition="WixBundleAction = 3 OR WixBundleAction = 4">#(loc.SuccessUninstallMessage)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.SuccessInstallMessage)</Text>
            </Label>
            <Label X="40" Y="250" Width="300" Height="20" FontId="2" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.RestartText)</Label>
            <Button Name="LaunchButton" X="40" Y="-40" Width="156" Height="44" TabStop="yes" FontId="4" HideWhenDisabled="yes">
                <Text>#(loc.LaunchButton)</Text>
                <ButtonImage ImageId="Primary" />
                <ButtonHoverImage ImageId="PrimaryHover" />
                <ButtonSelectedImage ImageId="PrimaryPressed" />
            </Button>
            <Button Name="SuccessRestartButton" X="40" Y="-40" Width="156" Height="44" TabStop="yes" FontId="4" HideWhenDisabled="yes">
                <Text>#(loc.RestartButton)</Text>
                <ButtonImage ImageId="Primary" />
                <ButtonHoverImage ImageId="PrimaryHover" />
                <ButtonSelectedImage ImageId="PrimaryPressed" />
            </Button>
            <Button X="208" Y="-40" Width="120" Height="44" TabStop="yes" FontId="4" VisibleCondition="WixBundleAction = 6 AND NOT WixStdBARestartRequired">
                <Text>#(loc.CloseButton)</Text>
                <ButtonImage ImageId="Secondary" />
                <ButtonHoverImage ImageId="SecondaryHover" />
                <ButtonSelectedImage ImageId="SecondaryPressed" />
                <CloseWindowAction />
            </Button>
            <Button X="40" Y="-40" Width="120" Height="44" TabStop="yes" FontId="4" VisibleCondition="WixBundleAction &lt;&gt; 6 AND NOT WixStdBARestartRequired">
                <Text>#(loc.CloseButton)</Text>
                <ButtonImage ImageId="Secondary" />
                <ButtonHoverImage ImageId="SecondaryHover" />
                <ButtonSelectedImage ImageId="SecondaryPressed" />
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Failure">
            <Label X="40" Y="136" Width="300" Height="36" FontId="1" DisablePrefix="yes">
                <Text>#(loc.FailureHeader)</Text>
                <Text Condition="WixBundleAction = 3 OR WixBundleAction = 4">#(loc.FailureUninstallHeader)</Text>
            </Label>
            <Hypertext Name="FailureLogFileLink" X="40" Y="180" Width="300" Height="40" FontId="2" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureLogText)</Hypertext>
            <Hypertext Name="FailureMessageText" X="40" Y="222" Width="300" Height="24" FontId="2" TabStop="yes" HideWhenDisabled="yes" />
            <Label X="40" Y="250" Width="300" Height="20" FontId="2" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
            <Button Name="FailureRestartButton" X="40" Y="-40" Width="156" Height="44" TabStop="yes" FontId="4" HideWhenDisabled="yes">
                <Text>#(loc.RestartButton)</Text>
                <ButtonImage ImageId="Primary" />
                <ButtonHoverImage ImageId="PrimaryHover" />
                <ButtonSelectedImage ImageId="PrimaryPressed" />
            </Button>
            <Button X="40" Y="-40" Width="120" Height="44" TabStop="yes" FontId="4" VisibleCondition="NOT WixStdBARestartRequired">
                <Text>#(loc.CloseButton)</Text>
                <ButtonImage ImageId="Secondary" />
                <ButtonHoverImage ImageId="SecondaryHover" />
                <ButtonSelectedImage ImageId="SecondaryPressed" />
                <CloseWindowAction />
            </Button>
        </Page>
    </Window>
</Theme>
